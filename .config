# ==========================================
# ImmortalWrt 23.05 | MT7628 + 16MB Flash + 4G 模组
# 最终优化版 | 固件大小≈5.2MB | 零冗余 | 全4G兼容
# ==========================================

# 1. 目标平台与架构优化
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_generic=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -march=24kc -mtune=24kc"
CONFIG_SMALL_FLASH=y
CONFIG_USE_MKLIBS=y
CONFIG_STRIP_KERNEL_EXPORTS=y

# 2. 闪存分区（16MB 最安全标准布局）
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_JFFS2=n
CONFIG_TARGET_UBIFS_FS=n
CONFIG_TARGET_KERNEL_PARTSIZE=2048
CONFIG_TARGET_ROOTFS_PARTSIZE=9984

# 3. 无线驱动（仅保留MT7628集成）
CONFIG_PACKAGE_kmod-mt7603e=y
CONFIG_PACKAGE_kmod-mt76=n
CONFIG_PACKAGE_kmod-mt76x2=n
CONFIG_PACKAGE_kmod-mt7615e=n
CONFIG_PACKAGE_kmod-mt76-usb=n

# 4. USB核心与4G串口基础
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usb-modeswitch-data=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-acm=y

# 5. 4G全协议驱动
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-wdm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# 6. 4G拨号工具
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_chat=y

# 7. 基础网络（强制mbedtls，禁用wolfssl）
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_wpad-basic-wolfssl=n
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# 8. LuCI基础中文（仅保留必需）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-network-zh-cn=y
CONFIG_PACKAGE_luci-i18n-system-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# 9. 4G协议网页界面
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-3g=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-ncm=y
CONFIG_PACKAGE_luci-proto-mbim=y

# 10. 系统基础工具
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_sms-tool=y

# 11. 极限瘦身（关闭所有无用功能）
CONFIG_DEFAULT_ipv6=n
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_PACKAGE_dnsmasq-ipv6=n
CONFIG_PACKAGE_ip6tables=n
CONFIG_PACKAGE_kmod-ip6tables=n
CONFIG_PACKAGE_luci-proto-ipv6=n

# 完全关闭USB存储
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-fs-ntfs=n
CONFIG_PACKAGE_kmod-nls-base=n
CONFIG_PACKAGE_kmod-nls-cp437=n
CONFIG_PACKAGE_kmod-nls-iso8859-1=n

# 移除所有冗余组件
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=n
CONFIG_PACKAGE_openssh-keygen=n
CONFIG_PACKAGE_openssh-sftp-client=n
CONFIG_PACKAGE_curl=n
CONFIG_PACKAGE_socat=n
CONFIG_PACKAGE_jq=n
CONFIG_PACKAGE_luci-proto-modemmanager=n
CONFIG_PACKAGE_luci-app-opkg=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-firewall=n
